{
    "name": "aidunite/payment-system",
    "description": "AidUnite会費徴収システム",
    "type": "wordpress-theme",
    "require": {
        "php": ">=7.4",
        "php-webdriver/webdriver": "^1.15",
        "stripe/stripe-php": "*",
        "tecnickcom/tcpdf": "^6.6"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.5",
        "phpunit/phpunit": "^9.6",
        "symfony/process": "^5.4",
        "yoast/phpunit-polyfills": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "AidUnite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AidUnite\\Tests\\": "tests/",
            "Tests\\": "tests/"
        },
        "files": [
            "tests/_support/MatchRequestTestFixture.php",
            "tests/_support/NormalizeTestHelper.php",
            "tests/_support/PermissionMatrixTestHelper.php",
            "tests/_support/MultiTeamTestFixture.php",
            "tests/_support/PermissionMatrixEvaluator.php"
        ]
    },
    "scripts": {
        "test": "phpunit -c phpunit-simple.xml --no-coverage",
        "test:unit": "phpunit -c phpunit-simple.xml --testsuite=unit --no-coverage",
        "test:integration": "phpunit -c phpunit-simple.xml --testsuite=integration --no-coverage",
        "test:all": "composer test",
        "test:e2e": "@php -r \"fwrite(STDERR, 'E2E は Playwright: npm run test:e2e（tests/e2e/README.md）\\n'); exit(1);\""
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}