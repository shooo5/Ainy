function Test-ScheduleRegistrationAPI {
    param([string]$Email, [string]$Password, [hashtable]$ScheduleData)
    try {
        if (-not $script:GlobalSession) {
            $script:GlobalSession = Invoke-Login -Email $Email -Password $Password
            if (-not $script:GlobalSession) {
                Write-TestLog "ログイン失敗" -Level "ERROR"
                return $false
            }
        }
        $restNonce = Get-WordPressRestNonce -BaseUrl $script:BaseUrl -Session $script:GlobalSession -PageUrl "$script:BaseUrl/mypage"
        if (-not $restNonce) {
            Write-TestLog "REST API Nonce取得失敗" -Level "ERROR"
            return $false
        }
        $apiUrl = "$script:BaseUrl/wp-json/aidunite/v1/register-schedule-v2"
        $headers = @{
            "Content-Type" = "application/json"
            "X-WP-Nonce" = $restNonce
        }
        $body = $ScheduleData | ConvertTo-Json -Depth 10
        Write-TestLog "API呼び出し前のセッションクッキー数: $($script:GlobalSession.Cookies.Count)" -Level "INFO"
        # クッキーを手動で確認・設定
        $cookieHeader = ""
        foreach ($cookie in $script:GlobalSession.Cookies) {
            if ($cookie.Value) {
                if ($cookieHeader) {
                    $cookieHeader += "; "
                }
                $cookieHeader += "$($cookie.Name)=$($cookie.Value)"
            }
        }
        if ($cookieHeader) {
            $headers["Cookie"] = $cookieHeader
            Write-TestLog "Cookieヘッダーを設定: $($cookieHeader.Substring(0, [Math]::Min(100, $cookieHeader.Length)))..." -Level "INFO"
        } else {
            Write-TestLog "警告: Cookieヘッダーが設定できませんでした（クッキー値がnull）" -Level "WARNING"
        }
        $response = Invoke-RestMethod -Uri $apiUrl -Method Post -Headers $headers -Body $body -WebSession $script:GlobalSession -ErrorAction Stop
        if ($response.success -eq $true) {
            Write-TestLog "スケジュール登録成功: schedule_id=$($response.data.schedule_id)" -Level "SUCCESS"
            return $true
        } else {
            Write-TestLog "スケジュール登録失敗: $($response.message)" -Level "ERROR"
            return $false
        }
    } catch {
        $errorMessage = $_.Exception.Message
        if ($_.Exception.Response) {
            try {
                $reader = New-Object System.IO.StreamReader($_.Exception.Response.GetResponseStream())
                $responseBody = $reader.ReadToEnd()
                $errorMessage += " - Response: $responseBody"
            } catch {
            }
        }
        Write-TestLog "API呼び出しエラー: $errorMessage" -Level "ERROR"
        return $false
    }
}

function Test-TC002_RegisterConfirmedSchedule {
    Write-TestLog "TC-002: 確定スケジュールの登録" -Level "INFO"
    $user = $script:TestUsers["test_use"]
    $futureDate = (Get-Date).AddDays(7).ToString("yyyy-MM-dd")
    $scheduleData = @{
        date = $futureDate
        start_time = "14:00"
        end_time = "16:00"
        type = "練習試合"
        intent = "confirmed"
        schedule_place = "home"
        schedule_gender = "male"
        note = "テスト用スケジュール"
    }
    $passed = Test-ScheduleRegistrationAPI -Email $user.Email -Password $user.Password -ScheduleData $scheduleData
    Write-TestResult "TC-002" "確定スケジュールの登録" $passed
}

function Test-TC003_RegisterTentativeSchedule {
    Write-TestLog "TC-003: 仮スケジュールの登録" -Level "INFO"
    $user = $script:TestUsers["test_use"]
    $futureDate = (Get-Date).AddDays(8).ToString("yyyy-MM-dd")
    $scheduleData = @{
        date = $futureDate
        start_time = "10:00"
        end_time = "12:00"
        type = "練習"
        intent = "tentative"
        schedule_place = "away"
        schedule_gender = "female"
    }
    $passed = Test-ScheduleRegistrationAPI -Email $user.Email -Password $user.Password -ScheduleData $scheduleData
    Write-TestResult "TC-003" "仮スケジュールの登録" $passed
}

function Test-TC004_RegisterRecruitSchedule {
    Write-TestLog "TC-004: マッチング希望スケジュールの登録（募集）" -Level "INFO"
    $user = $script:TestUsers["test_use"]
    $futureDate = (Get-Date).AddDays(9).ToString("yyyy-MM-dd")
    $scheduleData = @{
        date = $futureDate
        start_time = "15:00"
        end_time = "17:00"
        type = "練習試合"
        intent = "recruit"
        schedule_place = "home"
        schedule_gender = "male"
        male_teams = 1
        female_teams = 0
        venue_name = "テスト会場"
    }
    $passed = Test-ScheduleRegistrationAPI -Email $user.Email -Password $user.Password -ScheduleData $scheduleData
    Write-TestResult "TC-004" "マッチング希望スケジュールの登録（募集）" $passed
}

function Invoke-AllTests {
    Write-TestLog "============================================" -Level "INFO"
    Write-TestLog "マッチ系・スケジュール登録 E2Eテスト開始" -Level "INFO"
    Write-TestLog "============================================" -Level "INFO"
    Write-TestLog "ベースURL: $script:BaseUrl" -Level "INFO"
    Write-TestLog "開始時刻: $script:TestStartTime" -Level "INFO"
    Write-TestLog "" -Level "INFO"
    $script:GlobalSession = $null
    Write-TestLog "--- セクション1: スケジュール登録機能 ---" -Level "INFO"
    Test-TC001_ScheduleManagementPageDisplay
    Test-TC002_RegisterConfirmedSchedule
    Test-TC003_RegisterTentativeSchedule
    Test-TC004_RegisterRecruitSchedule
    Write-TestLog "" -Level "INFO"
    Write-TestLog "--- セクション2: マッチング機能（おススメ試合候補） ---" -Level "INFO"
    Test-TC007_RecommendedMatchesTabDisplay
    Test-TC008_MatchCardDisplay_BestMatch
    Write-TestLog "" -Level "INFO"
    Write-TestLog "--- セクション3: マッチング機能（すべての対戦募集） ---" -Level "INFO"
    Test-TC013_AllMatchListingsTabDisplay
    Test-TC014_MatchCardDisplay_AllListings
    Write-TestLog "" -Level "INFO"
    Write-TestLog "--- セクション4: タブ切り替えと統合テスト ---" -Level "INFO"
    Test-TC017_TabSwitching
    Write-TestLog "" -Level "INFO"
    $endTime = Get-Date
    $duration = $endTime - $script:TestStartTime
    $totalTests = $script:TestResults.Count
    $passedTests = ($script:TestResults | Where-Object { $_.Passed }).Count
    $failedTests = $totalTests - $passedTests
    Write-TestLog "============================================" -Level "INFO"
    Write-TestLog "テスト結果サマリー" -Level "INFO"
    Write-TestLog "============================================" -Level "INFO"
    Write-TestLog "総テスト数: $totalTests" -Level "INFO"
    Write-TestLog "成功: $passedTests" -Level "SUCCESS"
    Write-TestLog "失敗: $failedTests" -Level $(if ($failedTests -gt 0) { "ERROR" } else { "INFO" })
    Write-TestLog "実行時間: $($duration.TotalSeconds)秒" -Level "INFO"
    Write-TestLog "" -Level "INFO"
    if ($failedTests -gt 0) {
        Write-TestLog "失敗したテストケース:" -Level "ERROR"
        $script:TestResults | Where-Object { -not $_.Passed } | ForEach-Object {
            Write-TestLog "  - $($_.TestCaseId): $($_.TestCaseName)" -Level "ERROR"
            if ($_.Message) {
                Write-TestLog "    → $($_.Message)" -Level "ERROR"
            }
        }
    }
    $csvPath = "TestResults_$(Get-Date -Format 'yyyyMMdd_HHmmss').csv"
    $script:TestResults | Select-Object TestCaseId, TestCaseName, Passed, Message, Timestamp | Export-Csv -Path $csvPath -NoTypeInformation -Encoding utf8
    Write-TestLog "テスト結果をCSVファイルに出力しました: $csvPath" -Level "INFO"
    return $script:TestResults
}

if ($MyInvocation.InvocationName -ne '.') {
    try {
        Invoke-AllTests
    } catch {
        Write-TestLog "テスト実行中にエラーが発生しました: $_" -Level "ERROR"
        Write-TestLog $_.ScriptStackTrace -Level "ERROR"
        exit 1
    }
}
